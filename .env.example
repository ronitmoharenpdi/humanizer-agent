# Copy this file to .env for local runs. On Vercel set these in Project → Settings → Environment Variables.

# Required: Google Gemini (same key as the Content Outline Generator is fine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Portal lock (same values as the other agents). While AGENT_LAUNCH_SECRET is empty the lock is OFF.
AGENT_LAUNCH_SECRET=
AGENT_SLUG=humanizer
PORTAL_URL=https://npdi-proto.vercel.app

# Optional
MAX_INPUT_WORDS=6000
# Cost estimate shown on the page (USD per 1M tokens)
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50
